{
  "name": "@fleegital/web",
  "version": "0.4.0",
  "description": "The driver application form and website analytics for carriers running Fleegital.",
  "license": "MIT",
  "author": "Fleegital",
  "homepage": "https://github.com/fleegital/fleegital-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fleegital/fleegital-web.git"
  },
  "bugs": {
    "url": "https://github.com/fleegital/fleegital-web/issues"
  },
  "keywords": [
    "fleegital",
    "trucking",
    "recruiting",
    "cdl",
    "application-form",
    "analytics"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js"
    },
    "./layout.css": "./dist/styles/layout.css",
    "./form.css": "./dist/styles/form.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
